# 蚂蚁Cookie合集（Surge 版）
# 原作: MaYIHEI
# 上游来源: https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/loon/paperclip-cookie/paperclip-cookie.lpx
# 上游更新日期: 2026-10-28
# Egern 版: PCcookie/PCcookie.yaml（script_url ?v=2）
# 转换: 31 个脚本由 Egern 版去桥转换而来（js/PCcookie/*-surge.js），逻辑原样；
#   开关由 [Argument] 传入，脚本开头解析 $argument 后判断，关闭时直接 $done({}) 放行。
# 必须改写原因: 上游 surge/ 目录只有 README（暂无模块）、全仓无 .sgmodule；
#   上游 31 个原始 .js 虽是 Env 写法、Surge 能跑，但不读任何分应用开关（$argument 只用于 .merge 汇总通知），
#   .lpx 说明亦写明“没有单独开关，整个插件就是开关”；直引会丢掉 31 个开关，故按试点方法去桥转换。
# 注意: script-path 目前是占位 URL，待确认 Surge 版 JS 的托管位置后再替换。

[MITM]
hostname = %APPEND% api.weibo.cn, pbaccess.video.qq.com, vip.video.qq.com, api-takumi.miyoushe.com, api-takumi.mihoyo.com, app.mixcapp.com, shop-api.retail.mi.com, m.xiaomiyoupin.com, gw2c-hw-open.longfor.com, u6.y.qq.com, user-api-prd-mx.wandafilm.com, xunting.vbegin.com.cn, personal-act.wps.cn, api-cs.intsig.net, cn-wxmall.dreame.tech, cn-yx-wxmall.dreame.tech, www.nodeseek.com, pan1.me, pan.baidu.com, app-gw.shuye.com, client.app.coc.10086.cn, clientaccess.10086.cn, h5.bj.10086.cn, api.xiaoheihe.cn, popvip.paquapp.com, api.tuhu.cn, superapp-public.kiwa-tech.com, media.meituan.com, member-center.miniso.com, a.china-smartech.com, scrm-b.zjian.net, webapi.qmai.cn

