#!name=基础依赖 3in1
#!desc=Boxjs、Sub.Store、Script.Hub 基础依赖三合一
#!author=ChavyLeung · sub-store-org · Script-Hub-Org
#!homepage=https://github.com/idodo777/Me/tree/main/Base3in1
#!system=ios
#!arguments=Notify:开启通知
#!arguments-desc=Notify：ScriptHub通知；默认开启通知；填“关闭通知”关闭通知。

# 基础依赖 3in1（Surge 版）
# 原作: ChavyLeung · sub-store-org · Script-Hub-Org
# Egern 版: Base3in1/Base3in1.yaml
# 转换: 7 条脚本全是 http-request，直连上游地址，不用转 JS；
#   Notify 参数由 [Argument] 传入，两条 Script Hub 转换脚本经 argument=Notify={{{Notify}}} 传递。
# 注意: Egern 里 Notify 另有「关闭通知」「跟随链接」两个可选值，Surge 的 [Argument] 不支持下拉，
#   只取默认值「开启通知」；如需切换，在 Surge 模块编辑页把 Notify 的值改成对应文字即可。
# 注意: Sub-Store 两条的 Egern max_size: -1 在 Surge [Script] 里没有对应参数，已略去。

[MITM]
hostname = %APPEND% script.hub, *.script.hub, sub.store, boxjs.com, boxjs.net, *.boxjs.com, *.boxjs.net

[Script]
Script Hub 前端 = type=http-request, pattern=^https?://script\.hub/($|edit/|reload), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-hub.js, timeout=300
Script Hub 重写转换 = type=http-request, pattern=^https?://script\.hub/file/_start_/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module), script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js, timeout=300, argument=Notify={{{Notify}}}
Script Hub 规则集转换 = type=http-request, pattern=^https?://script\.hub/file/_start_/.+type=rule-set, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/rule-parser.js, timeout=300, argument=Notify={{{Notify}}}
Script Hub 脚本转换 = type=http-request, pattern=^https?://script\.hub/convert/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/script-converter.js, timeout=300
Sub-Store Core = type=http-request, pattern=^https?://sub\.store/((download)|api/(preview|sync|(utils/node-info))), script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-1.min.js, requires-body=true, timeout=600
Sub-Store Simple = type=http-request, pattern=^https?://sub\.store, script-path=https://github.com/sub-store-org/Sub-Store/releases/latest/download/sub-store-0.min.js, requires-body=true, timeout=600
BoxJS = type=http-request, pattern=^https?://(.+\.)?boxjs\.(com|net), script-path=https://raw.githubusercontent.com/chavyleung/scripts/master/box/chavy.boxjs.js, requires-body=true, timeout=120
