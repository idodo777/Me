#!name=Talkatone
#!desc=Talkatone分流去广告
#!author=eslco / LOWERTOP
#!homepage=https://github.com/idodo777/Me/tree/main/talkatone
#!system=ios
#!arguments=PROXY_POLICY:PROXY

# Talkatone 分流 + 去广告（Surge 版）
# 原 Surge 模块: eslco/base Talkatone_Opt.sgmodule（作者 eslco，规则来源 LOWERTOP）
# 由 Egern 版 talkatone.yaml 转回 Surge 格式，逻辑原样
# 注意: 仅适用于登录 Talkatone 后使用，不适用于注册

[Rule]
DOMAIN-KEYWORD,googleads,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick-cn.net,REJECT
DOMAIN-SUFFIX,lh3.googleadsserving.cn,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication-cn.com,REJECT
DOMAIN-SUFFIX,pubmatic.com,REJECT
DOMAIN-SUFFIX,smaato.net,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,au.w.inmobi.com,REJECT
DOMAIN-SUFFIX,talkatone.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,agkn.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,tenor.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,tktn.at,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,tktn.be,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,inner-active.mobi,DIRECT
DOMAIN-SUFFIX,crashlytics.com,DIRECT
DOMAIN-SUFFIX,mobilefuse.com,DIRECT
DOMAIN-SUFFIX,inmobi.com,DIRECT
DOMAIN-SUFFIX,kochava.com,DIRECT
IP-CIDR,216.172.154.0/24,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,23.19.73.39/32,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,34.120.13.18/32,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,23.253.145.244/32,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,23.235.228.136/29,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,72.18.158.120/29,{{{PROXY_POLICY}}},no-resolve
IP-CIDR,205.164.56.0/24,DIRECT,no-resolve
IP-CIDR,50.117.27.0/24,DIRECT,no-resolve
IP-CIDR,63.251.124.0/24,DIRECT,no-resolve
IP-CIDR,69.46.75.0/24,DIRECT,no-resolve

[URL Rewrite]
^https?://([^/]+\.)*cdn\.mobilefuse\.com/ - reject-img
^https?://([^/]+\.)*cdn2\.inner-active\.mobi/ - reject-img
^https?://([^/]+\.)*cdn-f\.adsmoloco\.com/ - reject-img
^https?://([^/]+\.)*impression\.link/ - reject-img
^https?://([^/]+\.)*impression-asia\.liftoff\.io/ - reject-img
^https?://([^/]+\.)*wv\.inner-active\.mobi/ - reject-img
^https?://([^/]+\.)*ads\.pubmatic\.com/ - reject-200
^https?://([^/]+\.)*amazon-adsystem\.com/ - reject-200
^https?://([^/]+\.)*app-analytics-services\.com/ - reject-200
^https?://([^/]+\.)*appier\.net/ - reject-200
^https?://([^/]+\.)*appiersig\.com/ - reject-200
^https?://([^/]+\.)*ads\.inmobi\.com/ - reject-200
^https?://([^/]+\.)*bidder\.criteo\.com/ - reject-200
^https?://([^/]+\.)*config\.inmobi\.com/ - reject-200
^https?://([^/]+\.)*cr\.adsappier\.com/ - reject-200
^https?://([^/]+\.)*ets-ap-southeast-1\.track\.smaato\.net/ - reject-200
^https?://([^/]+\.)*exchange-b-events\.inner-active\.mobi/ - reject-200
^https?://([^/]+\.)*ins\.track\.tappx\.com/ - reject-200
^https?://([^/]+\.)*mfx\.mobilefuse\.com/ - reject-200
^https?://([^/]+\.)*sdk-dnt\.ad\.smaato\.net/ - reject-200
^https?://([^/]+\.)*sdk-files\.smaato\.net/ - reject-200
^https?://([^/]+\.)*sdk-hb-cfg\.smaato\.net/ - reject-200
^https?://([^/]+\.)*ssp\.api\.tappx\.com/ - reject-200
^https?://([^/]+\.)*tappx\.com/ - reject-200
^https?://([^/]+\.)*view\.adjust\.com/ - reject-200
^https?://alt-r\.my\.com/mobile - reject-dict
^https?://imgx\.jampp\.com/imgsrv/tn - reject-img

[MITM]
hostname = %APPEND% alt-r.my.com, imgx.jampp.com, *.mobilefuse.com, *.inner-active.mobi, *.adsmoloco.com, impression.link, *.liftoff.io, ads.pubmatic.com, *.amazon-adsystem.com, *.inmobi.com, *.criteo.com, *.appier.net, *.appiersig.com, app-analytics-services.com, view.adjust.com, *.smaato.net, *.tappx.com, googleads.g.doubleclick.net, pagead2.googlesyndication-cn.com, pubmatic.com, smaato.net, criteo.com
