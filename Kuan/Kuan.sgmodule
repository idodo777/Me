# 酷安去广告（Surge 版）
# 原作: 小慧（转换自 ZenmoFeiShi / 怎么肥事、walala；feed/detail 与 replyList 补自 myouhi / xiaomaoJT 的公开去广告逻辑）
# 上游来源: https://github.com/Yi-r8/Surge/blob/main/sgmodule/Kuan.sgmodule
# 上游更新日期: 2026-11-14
# 拦截数量: 34
# 脚本数量: 0
# Egern 版: Kuan/kuan.yaml

[Rule]
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
AND,((DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
AND,((DOMAIN-SUFFIX,pglstatp-toutiao.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,pangle.io,REJECT
AND,((DOMAIN-SUFFIX,pangle.io),(PROTOCOL,QUIC)),REJECT
DOMAIN,ad.toutiao.com,REJECT
AND,((DOMAIN,ad.toutiao.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,tnc3-alisc1.zijieapi.com,REJECT
AND,((DOMAIN,tnc3-alisc1.zijieapi.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
AND,((DOMAIN-SUFFIX,gdt.qq.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,gdtimg.com,REJECT
AND,((DOMAIN-SUFFIX,gdtimg.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
AND,((DOMAIN-SUFFIX,pgdt.gtimg.cn),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,ad.qq.com,REJECT
AND,((DOMAIN-SUFFIX,ad.qq.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
AND,((DOMAIN-SUFFIX,e.qq.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,tanx.com,REJECT
AND,((DOMAIN-SUFFIX,tanx.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,kuaishouzt.com,REJECT
AND,((DOMAIN-SUFFIX,kuaishouzt.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,open.e.kuaishou.com,REJECT
AND,((DOMAIN-SUFFIX,open.e.kuaishou.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,kwaiad.com,REJECT
AND,((DOMAIN-SUFFIX,kwaiad.com),(PROTOCOL,QUIC)),REJECT
DOMAIN-SUFFIX,adkwai.com,REJECT
AND,((DOMAIN-SUFFIX,adkwai.com),(PROTOCOL,QUIC)),REJECT

[URL Rewrite]
^https?://api-access\.pangolin-sdk-toutiao\.com/api/ad/union/sdk - reject
^https://api\.coolapk\.com/v6/search\?.*type=hotSearch - reject-dict

[Body Rewrite]
http-response-jq ^https://api\.coolapk\.com/v6/main/init 'if (.data | type) != "array" then . else .data |= map(if (.extraDataArr | type) == "object" then .extraDataArr |= with_entries(select(.key | (startswith("SplashAd") or startswith("Ad.PRELOAD") or startswith("Ad.SPLASH") or startswith("Ad.ADLOAD")) | not)) elif (.extraDataArr | type) == "array" then .extraDataArr |= map(select(((.key // "") | (startswith("SplashAd") or startswith("Ad.PRELOAD") or startswith("Ad.SPLASH") or startswith("Ad.ADLOAD")) | not))) else . end) | del(.data[]? | select(.entityId == 944 or .entityId == 945 or .entityId == 24455 or .entityId == 36839 or .entityId == 1635 or .title == "关注")) | .data |= map(if .entities then .entities |= map(select(.entityId != 1635 and .entityId != 2261 and .entityId != 1633 and .entityId != 413 and .entityId != 417 and .entityId != 1754 and .entityId != 1966 and .entityId != 2274 and .entityId != 1170 and .entityId != 1175 and .entityId != 1190 and .entityId != 2258 and .title != "关注")) else . end) end'
http-response-jq ^https://api\.coolapk\.com/v6/main/indexV8 'if (.data | type) != "array" then . else .data |= map(select((.entityId != 32557 and .entityId != 29349 and .entityId != 28621) and (.entityTemplate != "sponsorCard") and (((.title // "") | test("值得买|红包")) | not))) end'
http-response-jq ^https://api\.coolapk\.com/v6/page/dataList 'if (.data | type) != "array" then . else .data |= map(select(.title != "话题热议" and (.entityTemplate != "sponsorCard") and (.entityId != 36104 and .entityId != 24309 and .entityId != 12889 and .entityId != 21063 and .entityId != 35730 and .entityId != 35846 and .entityId != 28374 and .entityId != 28375 and .entityId != 27332 and .entityId != 20090 and .entityId != 28773 and .entityId != 29343 and .entityId != 21106)) | if (.entities | type) == "array" then (.entities |= map(select(.title != "睡个好觉需要什么？" and .entityTemplate != "sponsorCard"))) else . end) end'
http-response-jq ^https://api\.coolapk\.com/v6/account/loadConfig\?key=my_page_card_config 'if (.data | type) != "array" then . else .data |= map(select(.entityType != "textLink" and (.entityId != 1001 and .entityId != 1003 and .entityId != 1004 and .entityId != 1005)) | if (.entities | type) == "array" then .entities |= map(select(.entityType != "textLink")) else . end) end'
http-response-jq ^https://api\.coolapk\.com/v6/feed/detail 'if (.data | type) != "object" then . else .data.include_goods = [] | .data.include_goods_ids = [] | .data.detailSponsorCard = [] | if (.data.hotReplyRows | type) == "array" then .data.hotReplyRows |= map(select(.id != null)) else . end | if (.data.topReplyRows | type) == "array" then .data.topReplyRows |= map(select(.id != null)) else . end end'
http-response-jq ^https://api\.coolapk\.com/v6/feed/replyList 'if (.data | type) != "array" then . else .data |= map(select(.id != null and .entityType != "card") | if (.replyRows | type) == "array" then .replyRows |= map(select(.id != null and .entityType != "card")) else . end) end'

[MITM]
hostname = %APPEND% api.coolapk.com
